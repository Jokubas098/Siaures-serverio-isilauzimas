rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Prisijungęs vartotojas su patvirtintu el. paštu
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function teacherPath() { return /databases/$(database)/documents/mokytojai/$(myEmail()); }

    // Mokytojas = el. paštas yra kolekcijoje "mokytojai"
    function isTeacher() { return signedIn() && exists(teacherPath()); }
    function isAdmin()   { return isTeacher() && get(teacherPath()).data.admin == true; }

    // Mokytojų sąrašas: kiekvienas mato save, administratorius – visus ir gali keisti
    match /mokytojai/{email} {
      allow get:  if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['admin'])
        && request.resource.data.admin is bool;
      allow delete: if isAdmin() && email != myEmail();
    }

    // Klausimų rinkiniai
    function validSet() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'shared', 'questions', 'ownerUid', 'ownerName', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.shared is bool
        && d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 200
        && d.ownerUid == request.auth.uid
        && d.ownerName is string && d.ownerName.size() <= 100;
    }

    match /rinkiniai/{id} {
      allow read: if isTeacher()
        && (resource.data.ownerUid == request.auth.uid || resource.data.shared == true);
      allow create: if isTeacher() && validSet();
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && validSet();
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    // Visa kita uždrausta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
